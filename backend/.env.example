# MongoDB
MONGODB_URI=mongodb://localhost:27017/emolearn
# For MongoDB Atlas: mongodb://username:password@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=...

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000

# AI Service
AI_SERVICE_URL=http://localhost:5001
AI_GATEWAY_URL=http://localhost:5000
AI_API_KEY=your_secure_ai_api_key_here
AI_TIMEOUT_MS=15000

# AI Study Assistant
# Create the key at https://platform.openai.com/api-keys and keep it server-side.
AI_ASSISTANT_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
# Optional Gemini fallback:
# GEMINI_API_KEY=replace_with_your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash-lite

# Security
BCRYPT_ROUNDS=12

# Data Retention
DATA_RETENTION_DAYS=180
